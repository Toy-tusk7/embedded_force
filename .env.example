# Copy to .env and fill in. Never commit .env.

# Claude API (Anthropic). When set, the agent runs on Claude instead of Nemotron.
ANTHROPIC_API_KEY=
# EMBEDFORGE_ANTHROPIC_MODEL=claude-opus-5-5
# EMBEDFORGE_EFFORT=high            # low | medium | high | xhigh | max
# EMBEDFORGE_PROVIDER=anthropic     # force a provider: anthropic | nebius | nvidia

# Nebius AI Cloud / Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional: NVIDIA API catalog / NIM (https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Tavily search (datasheet research)
TAVILY_API_KEY=

# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=EmbedForge

# Agent step budget per run
EMBEDFORGE_MAX_STEPS=60
