# Copy to .env and fill in. Never commit .env.

# NVIDIA Nemotron on Nebius Token Factory (OpenAI-compatible): the default provider. Key from https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily search (datasheet research). Key from https://tavily.com
TAVILY_API_KEY=

# Optional: Nemotron from the NVIDIA API catalog / NIM (https://build.nvidia.com), used when no Nebius key is set
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional other providers, used when no Nemotron provider is configured (or forced below)
ANTHROPIC_API_KEY=
# EMBEDFORGE_ANTHROPIC_MODEL=claude-opus-5-5
# EMBEDFORGE_EFFORT=high            # low | medium | high | xhigh | max
GEMINI_API_KEY=
# EMBEDFORGE_GEMINI_MODEL=gemini-3.8-flash
# EMBEDFORGE_PROVIDER=nebius        # force a provider: nebius | nvidia | anthropic | gemini

# Optional: LangSmith tracing (pip install -e ".[tracing]")
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=EmbedForge

# Agent step budget per run (extended by 30, up to 3 times, while the run is still making progress)
EMBEDFORGE_MAX_STEPS=60
